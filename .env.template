# This file contains a comprehensive list of environment variables for the boilerplate-app.
# It is generated from the Go configuration and includes defaults suitable for the Docker environment.
# Please replace placeholder values with your actual configuration.

# --- Backend Server Settings ---
# See internal/config/config.go for ServerConfig
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_ALLOWED_ORIGINS=http://localhost:8090
SERVER_ALLOWED_HEADERS=

# --- Logging Settings ---
# See internal/config/config.go for LogConfig
LOG_LEVEL=info
LOG_STYLE=json  # either colour, json or plain

# --- Authentication Settings ---
# See internal/config/config.go for AuthConfig
SECRET_KEY=your-super-secret-key
JWT_AUDIENCE=boilerplate-app
JWT_ISSUER=boilerplate-auth
TOKEN_LIFETIME=24h
VERIFICATION_TOKEN_TTL=30m

# --- PostgreSQL Database Settings ---
# See internal/config/config.go for DatabaseConfig
# The DATABASE_URL is constructed from the variables below in the Go app, but is provided here for convenience.
DATABASE_URL=postgres://admin:password@postgres-db:5432/app_db?sslmode=disable
DB_DRIVER=postgres
DB_HOST=postgres-db
DB_PORT=5432
DB_USER=admin
DB_PASSWORD=password
DB_NAME=app_db
DB_SSLMODE=disable
DB_TIMEZONE=Africa/Lagos
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_IDLE_TIME=5m
DB_CONN_MAX_LIFETIME=1h
ECHO_SQL=false

# --- Valkey/Redis Settings ---
# See internal/config/config.go for RedisConfig
REDIS_HOST=valkey
REDIS_PORT=6379
REDIS_DB=0
REDIS_USER=
REDIS_PASSWORD=
REDIS_USE_SSL=false

# --- Mail Server (SMTP) Settings ---
# See internal/config/config.go for SMTPConfig
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_SENDER=noreply@example.com
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_USE_TLS=false
MAIL_TIMEOUT=5s

# --- Background Job Queue Settings ---
# See internal/config/config.go for QueueConfig
JOB_CONCURRENCY=10
JOB_QUEUES=critical:6,default:3,low:1
JOB_REDIS_HOST=valkey
JOB_REDIS_PORT=6379
JOB_REDIS_DB=0
JOB_REDIS_USER=
JOB_REDIS_PASSWORD=
JOB_REDIS_USE_SSL=false

# --- Cache settings ---
CACHE_REDIS_HOST=valkey
CACHE_REDIS_PORT=6379
CACHE_REDIS_DB=0
CACHE_REDIS_USER=
CACHE_REDIS_PASSWORD=
CACHE_REDIS_USE_SSL=false

# --- Routing Settings ---
# See internal/config/config.go for RoutingConfig
BASE_URL=http://localhost:8080
FRONTEND_BASE_URL=http://localhost:8090

# --- Frontend Settings ---
# These are passed to the frontend build process.
FRONTEND_PORT=8090
VITE_APP_BASE_URL=http://localhost:8080
